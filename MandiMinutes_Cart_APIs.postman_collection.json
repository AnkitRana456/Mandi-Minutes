{
  "info": {
    "_postman_id": "mm-cart-api-collection",
    "name": "MandiMinutes - Cart & Auth APIs",
    "description": "Postman Collection for testing Login and Cart APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Login (Auto-saves JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseData = pm.response.json();",
              "var token = responseData.token || responseData.jwtToken || responseData.accessToken;",
              "if (token) {",
              "    pm.collectionVariables.set('jwtToken', token);",
              "    console.log('JWT Token successfully set:', token);",
              "} else {",
              "    console.error('Token not found in response');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul.customer@gmail.com\",\n  \"password\": \"Password123\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/user/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "user",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Get Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cart/getCart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cart",
            "getCart"
          ]
        }
      }
    },
    {
      "name": "3. Add Item to Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cart/add",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cart",
            "add"
          ]
        }
      }
    },
    {
      "name": "4. Update Item Quantity",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cart/items?productId=1&quantity=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cart",
            "items"
          ],
          "query": [
            {
              "key": "productId",
              "value": "1"
            },
            {
              "key": "quantity",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "5. Remove Item from Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cart/deleteItems?productId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cart",
            "deleteItems"
          ],
          "query": [
            {
              "key": "productId",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "6. Clear Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cart/clear",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cart",
            "clear"
          ]
        }
      }
    }
  ]
}